{
  "name": "fit-together",
  "version": "1.0.0",
  "private": true,
  "description": "Train with your partner. Rank up together.",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "cap:sync": "npm run sync:web && npx cap sync && node scripts/register-native-plugins.mjs",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "check:equipment": "node scripts/build-equipment.mjs --check",
    "check:motion": "node knowledge/motion/validate.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/keep-awake": "^7.1.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.7"
  }
}
